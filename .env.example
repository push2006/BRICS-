# BRICS Live Monitor — copy this file to .env and fill in the values you need.
# Every feature is OFF by default. Only turn on the ones you will actually use.

# ---- Deploy / storage ----
DEPLOY_MODE=local                  # local | cloud
STORAGE_BACKEND=sqlite             # sqlite | mongodb
SQLITE_PATH=data/newsbot.db
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=newsbot

# ---- Delivery channels (all off by default) ----
ENABLE_EMAIL=false
EMAIL_FROM=
EMAIL_TO=
EMAIL_APP_PASSWORD=                # Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

ENABLE_WHATSAPP=false
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Schedule ----
COLLECT_INTERVAL_TIER1_MINUTES=10  # wire agencies (TASS, RIA, Xinhua, IRNA…)
COLLECT_INTERVAL_TIER2_MINUTES=30  # regular outlets
DIGEST_TIMES=09:00,20:00

# ---- Cloud trigger security (change before public deploy) ----
TRIGGER_SECRET=changeme

# ---- Optional features ----
ENABLE_CRITICAL_ALERTS=false
CRITICAL_KEYWORDS=attack,explosion,resign,coup,ceasefire,sanctions

ENABLE_WEEKLY_REPORT=false
WEEKLY_REPORT_DAY=Monday

ENABLE_DASHBOARD=true
DASHBOARD_KEY=changeme             # used by the on-page “add stream” form

ENABLE_TIER3_SCRAPE=false          # official sites that need custom scraping

DEDUPE_THRESHOLD=0.8
ACTIVE_CATEGORIES=GEOPOLITICS,TRADE,SANCTIONS,RISK,CONFERENCE,GENERAL

SOURCES_FILE=config/sources.yaml
