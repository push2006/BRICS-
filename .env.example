########################################################################
# BRICS LIVE MONITOR — config
# Copy to `.env` and fill in what you switch ON. Defaults to local +
# SQLite so `python run_all.py` works immediately with zero accounts.
########################################################################

# ---- DEPLOY MODE ----
# local  -> python run_all.py runs scheduler + dashboard together, 24/7 on your machine
# cloud  -> deploy web.py to Render; an external scheduler drives the 24/7 loop
DEPLOY_MODE=local

# ---- STORAGE ----
STORAGE_BACKEND=sqlite
SQLITE_PATH=data/newsbot.db
MONGODB_URI=
MONGODB_DB=brics_monitor

# ---- EMAIL DIGEST ----
ENABLE_EMAIL=false
EMAIL_FROM=
EMAIL_TO=
EMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ---- WHATSAPP ----
ENABLE_WHATSAPP=false
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# ---- TELEGRAM ----
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- SCHEDULE (local mode) ----
# Lower = faster/more up-to-date, but more requests to each source.
# 5 min is a reasonable balance for summit-days coverage.
COLLECT_INTERVAL_MINUTES=5
DIGEST_TIMES=09:00,14:00,20:00

# ---- CLOUD TRIGGER SECURITY ----
TRIGGER_SECRET=changeme

# ---- DASHBOARD "ADD LIVE STREAM" SECURITY ----
# Required to add/remove live streams from the dashboard UI (bottom of the
# Live Feeds card). Set this to something real, especially if you're
# forwarding/tunneling the dashboard to a public URL — otherwise anyone
# with the link can add or delete your streams.
DASHBOARD_KEY=changeme

# ---- ALERTS ----
ENABLE_CRITICAL_ALERTS=true
CRITICAL_KEYWORDS=attack,explosion,resign,coup,ceasefire,sanctions,declaration signed,walkout

ENABLE_WEEKLY_REPORT=false
WEEKLY_REPORT_DAY=Monday

ENABLE_TIER3_SCRAPE=false
DEDUPE_THRESHOLD=0.8
ACTIVE_CATEGORIES=GEOPOLITICS,TRADE,SANCTIONS,RISK,CONFERENCE,GENERAL
